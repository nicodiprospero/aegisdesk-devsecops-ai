# Jeito fácil:  python3 scripts/setup_env.py   → cria o .env com chave, hash e canário gerados
# (o .env está no .gitignore e no .dockerignore — nunca vai para o Git nem para a imagem)
AEGIS_ENV=prod

# Hash SHA-256 da(s) chave(s) de API, separados por vírgula. A chave em texto puro NÃO fica no servidor.
# Gerar chave:  python -c "import secrets;print(secrets.token_urlsafe(32))"
# Gerar hash:   python -c "import hashlib,sys;print(hashlib.sha256(sys.argv[1].encode()).hexdigest())" 'SUA_CHAVE'
AEGIS_API_KEY_HASHES=

# Token canário (detecção de vazamento do prompt de sistema — OWASP LLM08)
# Gerar: python -c "import secrets;print('CANARY-'+secrets.token_hex(8))"
AEGIS_CANARY_TOKEN=

AEGIS_OLLAMA_MODEL=qwen2.5:3b
AEGIS_MAX_INPUT_CHARS=2000
AEGIS_MAX_OUTPUT_TOKENS=512
AEGIS_RATE_LIMIT_PER_MINUTE=20
